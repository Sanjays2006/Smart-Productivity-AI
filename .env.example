# FocusAI environment configuration — copy to `.env` and fill in real values.
# NEVER commit the real .env file. (.env is git-ignored.)

# ─── JWT ───────────────────────────────────────────────────────────────────
# Generate a strong secret, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_base64_secret
JWT_EXPIRATION=604800000

# ─── Fallback admin account ────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=replace_with_a_strong_password

# ─── Server ────────────────────────────────────────────────────────────────
SERVER_PORT=8080
H2_CONSOLE_ENABLED=false

# ─── Ollama ────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3

# ─── PostgreSQL (production) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=focusai_db
DB_USERNAME=postgres
DB_PASSWORD=replace_with_a_strong_password
